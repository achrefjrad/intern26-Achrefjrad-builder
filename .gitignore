# ======= WEBSITE BUILDER ROOT GITIGNORE =======

# --- Python / Backend (Backend is inside /backend/) ---

# Ignore the virtual environment in the project root
/venv/

# Environment files
.env
/backend/.env

# Python compilation files
/backend/__pycache__/
*.pyc

# The Django SQLite development database (CRITICAL)
/backend/db.sqlite3

# The media uploads folder (CRITICAL - don't commit user images)
/backend/media/


# --- Node / Next.js / Frontend (Frontend is inside /frontend/) ---

# dependencies
/frontend/node_modules/
/frontend/.pnp
/frontend/.pnp.*
/frontend/.yarn/*
!/frontend/.yarn/patches
!/frontend/.yarn/plugins
!/frontend/.yarn/releases
!/frontend/.yarn/versions

# testing
/frontend/coverage/

# next.js output
/frontend/.next/
/frontend/out/

# production build output
/frontend/build/

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel deployment config
/frontend/.vercel/

# TypeScript configuration (Keep tsconfig.json, but some ignore d.ts)
/frontend/*.tsbuildinfo
# /frontend/next-env.d.ts  <-- (Commented out, safely keep config files)

# --- General ---
.DS_Store
*.pem